for (type in file_types) {
old_file <- file.path(path, paste0("old_", type))
new_file <- file.path(path, paste0("new_", type))
if (file.exists(old_file) && file.exists(new_file)) {
message("\n====== Comparing: ", type, " ======")
old_df <- read_tsv(old_file, show_col_types = FALSE)
new_df <- read_tsv(new_file, show_col_types = FALSE)
common_cols <- intersect(colnames(old_df), colnames(new_df))
old_df <- old_df[, common_cols]
new_df <- new_df[, common_cols]
# Get only numeric columns
numeric_cols <- common_cols[sapply(old_df, is.numeric)]
# For each numeric column, compute relative difference quantiles
quant_list <- lapply(numeric_cols, function(col) {
old_vals <- old_df[[col]]
new_vals <- new_df[[col]]
# Only compare rows where both are non-NA
valid <- !is.na(old_vals) & !is.na(new_vals)
rel_diff <- abs(new_vals[valid] - old_vals[valid]) /
(abs(old_vals[valid]) + 1e-10)  # avoid division by zero
quantiles <- quantile(rel_diff, probs = c(0, 0.25, 0.5, 0.75, 0.90, 0.95, 1.0))
data.frame(
column    = col,
min       = quantiles[1],
Q25       = quantiles[2],
median    = quantiles[3],
Q75       = quantiles[4],
Q90       = quantiles[5],
Q95       = quantiles[6],
max       = quantiles[7],
n_valid   = sum(valid),
n_na_old  = sum(is.na(old_vals)),
n_na_new  = sum(is.na(new_vals))
)
})
quant_df <- bind_rows(quant_list)
print(quant_df, n = Inf)
# Also write to file for easy inspection
write_tsv(quant_df, file.path(path, paste0("quantile_diff_", type)))
}
}
