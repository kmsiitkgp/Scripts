path <- "C:/Users/kailasamms/OneDrive - Cedars-Sinai Health System/Desktop/compare"
files <- list.files(path)
# 1. Define the unique suffixes that pair your old and new files
# (Notice we exclude 'frac' if you only want count, mean, and sum)
file_types <- c(
"count_total_c.tsv",
"mean_total_c.tsv",
"sum_total_c.tsv",
"sum_hmc.tsv",
"sum_mc.tsv",
"frac_hmc.tsv",
"frac_mc.tsv"
)
for (type in file_types) {
old_file <- paste0("old_", type)
new_file <- paste0("new_", type)
# Check if both the old and new files actually exist before running
if (file.exists(old_file) && file.exists(new_file)) {
message("Comparing: ", type)
# Read the TSVs
old_df <- read_tsv(file.path(path, old_file), show_col_types = FALSE)
new_df <- read_tsv(file.path(path, new_file), show_col_types = FALSE)
# Assume the first column is the sample identifier (e.g., sample ID)
id_col <- colnames(old_df)[1]
# Identify the value column (the 2nd column containing the actual numbers)
val_col_old <- colnames(old_df)[2]
val_col_new <- colnames(new_df)[2]
# Merge the dataframes together based on sample ID
merged_df <- inner_join(old_df, new_df, by = id_col, suffix = c("_old", "_new"))
# Create clean column names dynamically
# For example: mean_old, mean_new, mean_diff
base_name <- str_remove(type, "\\.tsv$") # removes the .tsv extension
old_name <- paste0(base_name, "_old")
new_name <- paste0(base_name, "_new")
diff_name <- paste0(base_name, "_diff")
# Rename original columns and compute the difference (New - Old)
final_df <- merged_df %>%
rename(!!old_name := all_of(val_col_old),
!!new_name := all_of(val_col_new)) %>%
mutate(!!diff_name := .data[[new_name]] - .data[[old_name]])
# Save the individual comparison to a new file
output_filename <- paste0("comparison_", type)
write_tsv(final_df, output_filename)
message("--> Saved results to: ", output_filename)
} else {
warning("Skipping ", type, " because either the old or new file is missing.")
}
}
message("\nAll comparisons completed!")
