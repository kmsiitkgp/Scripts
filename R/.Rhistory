"frac_mc.tsv"
)
for (type in file_types) {
old_file <- file.path(path, paste0("old_", type))
new_file <- file.path(path, paste0("new_", type))
# Check if both the old and new files actually exist before running
if (file.exists(old_file) && file.exists(new_file)) {
message("Comparing: ", type)
# Read the TSVs
old_df <- read_tsv(old_file, show_col_types = FALSE)
new_df <- read_tsv(new_file, show_col_types = FALSE)
common_cols <- intersect(colnames(old_df), colnames(new_df))
old_df <- old_df[, common_cols]
new_df <- new_df[, common_cols]
print(all.equal(old_df, new_df, check.attributes = FALSE))
