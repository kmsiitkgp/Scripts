library(readr)
library(dplyr)
library(openxlsx)
library(GenomicRanges)
library(rtracklayer)
library(purrr)
path <- "C:/Users/kailasamms/OneDrive - Cedars-Sinai Health System/Desktop/Collaboration projects data/Biomodal"
output_dir <- path
gmt_dir <- "C:/Users/kailasamms/OneDrive - Cedars-Sinai Health System/Documents/Signatures/Human"
# ═══════════════════════════════════════════════════════════════════════════════
# ---- Cross check biomodal outputs for accuracy ----
# ═══════════════════════════════════════════════════════════════════════════════
# (i) CpG site counts must be identical across all 3 modification types
#     because they all interrogate the same set of CpG positions
count_hmc     <- readr::read_tsv(file.path(path, "biomodal_output", "count_hmc.tsv"), show_col_types = FALSE)
count_mc      <- readr::read_tsv(file.path(path, "biomodal_output", "count_mc.tsv"), show_col_types = FALSE)
count_total_c <- readr::read_tsv(file.path(path, "biomodal_output", "count_total_c.tsv"), show_col_types = FALSE)
all.equal(as.data.frame(count_hmc), as.data.frame(count_mc),      check.attributes = FALSE)
all.equal(as.data.frame(count_hmc), as.data.frame(count_total_c), check.attributes = FALSE)
# (ii) Verify fractions: sum(hmc) / sum(total_c) should equal frac_hmc (and same for mc)
#      Non-zero sum confirms no systematic computation errors in Biomodal output
frac_hmc    <- readr::read_tsv(file.path(path, "biomodal_output", "frac_hmc.tsv"), show_col_types = FALSE)
frac_mc     <- readr::read_tsv(file.path(path, "biomodal_output", "frac_mc.tsv"), show_col_types = FALSE)
sum_hmc     <- readr::read_tsv(file.path(path, "biomodal_output", "sum_hmc.tsv"), show_col_types = FALSE)
sum_mc      <- readr::read_tsv(file.path(path, "biomodal_output", "sum_mc.tsv"), show_col_types = FALSE)
sum_total_c <- readr::read_tsv(file.path(path, "biomodal_output", "sum_total_c.tsv"), show_col_types = FALSE)
sum(round(sum_hmc[4:27]     / sum_total_c[4:27] - frac_hmc[4:27], 2), na.rm = TRUE)
View(frac_hmc)
colnames(frac_hmc)
sum(round(sum_hmc[4:24]/ sum_total_c[4:24] - frac_hmc[4:24], 2), na.rm = TRUE)
sum(round(sum_mc[4:24] / sum_total_c[4:24] - frac_mc[4:24],  2), na.rm = TRUE)
all.equal(sum_hmc[4:24]/ sum_total_c[4:24] == frac_hmc[4:24], check.attributes = FALSE)
all.equal(sum_hmc[4:24]/ sum_total_c[4:24], frac_hmc[4:24], check.attributes = FALSE)
all.equal(round(sum_hmc[4:24]/ sum_total_c[4:24], 2), round(frac_hmc[4:24],2), check.attributes = FALSE)
# ═══════════════════════════════════════════════════════════════════════════════
# ---- Build normal methylation reference ----
# ═══════════════════════════════════════════════════════════════════════════════
# Goal: identify genes with baseline 5hmC/5mC in normal samples so we can
# subtract them from cfDNA results to isolate tumor-specific signal.
#
# 5hmC reference: benign prostate tissue (GSE144530, n=5, narrowPeak, hg19)
# 5mC reference:  healthy plasma cfDNA (n=29, BED, hg19)
#
# Since our Biomodal data is hg38 and references are hg19, direct coordinate
# comparison is not feasible. Instead we annotate both against gene models and
# compare at gene name + region level (Promoter / TSS / Gene body).
#
# Reference threshold: gene must be present in >=80% of normal samples.
# Strict intersection (all samples) was tested but rejected — one low-coverage
# sample (5hmC sample 3: 2604 genes vs 3173-5701 in others) artificially halved
# the reference size. Majority rule is more robust to coverage variability.
# 1️⃣ Define Helper Functions
# Vectorized helper: groups hits upfront and collapses gene names
get_collapsed_genes <- function(peaks, hits, subject_gr) {
# splitAsList is the high-performance way to group hits by peak index
hits_by_query <- S4Vectors::splitAsList(
S4Vectors::subjectHits(hits),
S4Vectors::queryHits(hits),
length(peaks)
)
sapply(hits_by_query, function(idx) {
# Ensure 'gene_name' matches your GTF column name
unique_names <- unique(S4Vectors::mcols(subject_gr)$gene_name[idx])
if (length(unique_names) == 0) return("NA")
paste(unique_names, collapse = ";")
})
}
# Helper to extract and split unique genes from the annotation dataframes
extract_unique_genes <- function(df_list, col_name, logical_col) {
lapply(df_list, function(df) {
# Base R filtering and splitting is faster/lighter than separate_longer_delim
genes <- df[[col_name]][df[[logical_col]] & df[[col_name]] != "NA"]
if (length(genes) == 0) return(character(0))
unique(unlist(strsplit(as.character(genes), ";", fixed = TRUE)))
})
}
# Majority rule: gene must appear in >= X% of samples
get_majority_genes <- function(gene_lists, threshold = 0.8) {
if (length(gene_lists) == 0) return(character(0))
n         <- length(gene_lists)
min_count <- ceiling(threshold * n)
gene_freq <- table(unlist(gene_lists))
names(gene_freq[gene_freq >= min_count])
}
# 2️⃣ Import and Prepare Regions
gtf_file      <- file.path(path, "biomodal_output", "hg19.refGene.gtf.gz")
gtf           <- rtracklayer::import(con = gtf_file, format = "gtf")
transcripts   <- gtf[S4Vectors::mcols(gtf)$type == "transcript"]
gene_body_gr  <- transcripts
promoter_gr   <- GenomicRanges::promoters(transcripts, upstream = 1000, downstream = 0)
tss_region_gr <- GenomicRanges::promoters(transcripts, upstream = 200,  downstream = 200)
# 3️⃣ Annotation Process
annotate_peaks <- function(peak_file, format) {
peaks <- rtracklayer::import(con = peak_file, format = format)
# Safety check: Use row numbers if BED file has no 'name' column
peak_names <- if (!is.null(S4Vectors::mcols(peaks)$name)) S4Vectors::mcols(peaks)$name else paste0("peak_", seq_along(peaks))
promoter_hits  <- GenomicRanges::findOverlaps(peaks, promoter_gr)
tss_hits       <- GenomicRanges::findOverlaps(peaks, tss_region_gr)
gene_body_hits <- GenomicRanges::findOverlaps(peaks, gene_body_gr)
data.frame(
peak_name            = peak_names,
peak_chr             = GenomicRanges::seqnames(peaks),
peak_start           = GenomicRanges::start(peaks),
peak_end             = GenomicRanges::end(peaks),
in_promoter          = GenomicRanges::countOverlaps(peaks, promoter_gr)  > 0,
in_tss               = GenomicRanges::countOverlaps(peaks, tss_region_gr) > 0,
in_gene_body         = GenomicRanges::countOverlaps(peaks, gene_body_gr)  > 0,
promoter_gene_names  = get_collapsed_genes(peaks, promoter_hits,  promoter_gr),
tss_gene_names       = get_collapsed_genes(peaks, tss_hits,       tss_region_gr),
gene_body_gene_names = get_collapsed_genes(peaks, gene_body_hits, gene_body_gr)
)
}
# Run annotations
normal_5hmc_files <- list.files(file.path(path, "Benign_prostate_5hmc"), full.names = TRUE)
normal_5mc_files  <- list.files(file.path(path, "Healthy_plasma_5mc"),   full.names = TRUE)
annotated_list <- list(
normal_5hmc = lapply(normal_5hmc_files, function(f) annotate_peaks(f, "narrowPeak")),
normal_5mc  = lapply(normal_5mc_files,  function(f) annotate_peaks(f, "BED"))
)
# 1️⃣ Define Helper Functions
# Vectorized helper: groups hits upfront and collapses gene names
get_collapsed_genes <- function(peaks, hits, subject_gr) {
# Fix: Use factor levels to ensure all peaks are represented,
# and explicitly name the 'length' argument to avoid the 'drop' error.
hits_by_query <- S4Vectors::splitAsList(
x = S4Vectors::subjectHits(hits),
f = factor(S4Vectors::queryHits(hits), levels = seq_along(peaks))
)
sapply(hits_by_query, function(idx) {
# Check if subject_gr has 'gene_name' or 'gene_id' based on your GTF
# For hg19.refGene, it is usually 'gene_id'
mcols_data <- S4Vectors::mcols(subject_gr)
col_to_use <- if ("gene_name" %in% colnames(mcols_data)) "gene_name" else "gene_id"
unique_names <- unique(mcols_data[[col_to_use]][idx])
if (length(unique_names) == 0) return("NA")
paste(unique_names, collapse = ";")
})
}
# Helper to extract and split unique genes from the annotation dataframes
extract_unique_genes <- function(df_list, col_name, logical_col) {
lapply(df_list, function(df) {
# Base R filtering and splitting is faster/lighter than separate_longer_delim
genes <- df[[col_name]][df[[logical_col]] & df[[col_name]] != "NA"]
if (length(genes) == 0) return(character(0))
unique(unlist(strsplit(as.character(genes), ";", fixed = TRUE)))
})
}
# Majority rule: gene must appear in >= X% of samples
get_majority_genes <- function(gene_lists, threshold = 0.8) {
if (length(gene_lists) == 0) return(character(0))
n         <- length(gene_lists)
min_count <- ceiling(threshold * n)
gene_freq <- table(unlist(gene_lists))
names(gene_freq[gene_freq >= min_count])
}
# 2️⃣ Import and Prepare Regions
gtf_file      <- file.path(path, "biomodal_output", "hg19.refGene.gtf.gz")
gtf           <- rtracklayer::import(con = gtf_file, format = "gtf")
transcripts   <- gtf[S4Vectors::mcols(gtf)$type == "transcript"]
gene_body_gr  <- transcripts
promoter_gr   <- GenomicRanges::promoters(transcripts, upstream = 1000, downstream = 0)
tss_region_gr <- GenomicRanges::promoters(transcripts, upstream = 200,  downstream = 200)
# 3️⃣ Annotation Process
annotate_peaks <- function(peak_file, format) {
peaks <- rtracklayer::import(con = peak_file, format = format)
# Safety check: Use row numbers if BED file has no 'name' column
peak_names <- if (!is.null(S4Vectors::mcols(peaks)$name)) S4Vectors::mcols(peaks)$name else paste0("peak_", seq_along(peaks))
promoter_hits  <- GenomicRanges::findOverlaps(peaks, promoter_gr)
tss_hits       <- GenomicRanges::findOverlaps(peaks, tss_region_gr)
gene_body_hits <- GenomicRanges::findOverlaps(peaks, gene_body_gr)
data.frame(
peak_name            = peak_names,
peak_chr             = GenomicRanges::seqnames(peaks),
peak_start           = GenomicRanges::start(peaks),
peak_end             = GenomicRanges::end(peaks),
in_promoter          = GenomicRanges::countOverlaps(peaks, promoter_gr)  > 0,
in_tss               = GenomicRanges::countOverlaps(peaks, tss_region_gr) > 0,
in_gene_body         = GenomicRanges::countOverlaps(peaks, gene_body_gr)  > 0,
promoter_gene_names  = get_collapsed_genes(peaks, promoter_hits,  promoter_gr),
tss_gene_names       = get_collapsed_genes(peaks, tss_hits,       tss_region_gr),
gene_body_gene_names = get_collapsed_genes(peaks, gene_body_hits, gene_body_gr)
)
}
# Run annotations
normal_5hmc_files <- list.files(file.path(path, "Benign_prostate_5hmc"), full.names = TRUE)
normal_5mc_files  <- list.files(file.path(path, "Healthy_plasma_5mc"),   full.names = TRUE)
annotated_list <- list(
normal_5hmc = lapply(normal_5hmc_files, function(f) annotate_peaks(f, "narrowPeak")),
normal_5mc  = lapply(normal_5mc_files,  function(f) annotate_peaks(f, "BED"))
)
